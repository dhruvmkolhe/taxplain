# Server-Side Protected API Keys (Stored on server, never exposed to client browser)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
# Preferred AI Provider (nvidia)
ACTIVE_AI_PROVIDER=nvidia

# Application URL
APP_URL=

# Google Analytics 4 Measurement ID (injected at build time via Vite env replacement)
# Get this from https://analytics.google.com → Admin → Data Streams → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
